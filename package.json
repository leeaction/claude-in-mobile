{
  "name": "claude-in-mobile",
  "version": "3.3.0",
  "description": "MCP server for mobile automation - Android (ADB + Sonic) and iOS (simctl + Sonic)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-in-mobile": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "android",
    "ios",
    "mobile",
    "automation",
    "adb",
    "simctl",
    "sonic",
    "claude",
    "anthropic",
    "model-context-protocol"
  ],
  "author": "Alex Gladkov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexGladkov/claude-in-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/AlexGladkov/claude-in-mobile/issues"
  },
  "homepage": "https://github.com/AlexGladkov/claude-in-mobile#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jimp": "^1.6.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
